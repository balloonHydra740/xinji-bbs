{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xinji-bbs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xinji-bbs",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}